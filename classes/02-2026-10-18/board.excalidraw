      "link": null,
      "locked": false,
      "text": "min <- A[1]\nmax <- A[1]\ndla i = 1, 2, ..., N\n    jezeli A[i] < min\n        min <- A[i]\n    jezeli A[i] > max\n        max <- A[i]\nwypisz max, min",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "min <- A[1]\nmax <- A[1]\ndla i = 1, 2, ..., N\n    jezeli A[i] < min\n        min <- A[i]\n    jezeli A[i] > max\n        max <- A[i]\nwypisz max, min",
      "autoResize": false,
      "lineHeight": 1.25,
